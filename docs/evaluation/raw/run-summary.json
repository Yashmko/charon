  "inconclusive_cases": [
    {
      "baseline_status_code": 200,
      "case_id": "home-policy-unclear",
      "expected_result": "inconclusive",
      "observed_classes": [
        "API1",
        "API3",
        "internal:missing-authorization"
      ],
      "reason": "The pinned README/OpenAPI identify the route as VAmPI home but do not state whether its access is intentionally public. It is therefore inconclusive, not a not_vulnerable negative control.",
      "vulnerability_class": "Access-control policy unspecified for the VAmPI home response"
    },
    {
      "baseline_status_code": 200,
      "case_id": "users-list-public",
      "expected_result": "inconclusive",
      "observed_classes": [
        "API1",
        "internal:missing-authorization"
      ],
      "reason": "The README documents public access to minimal information about dummy users, but this runner registers Alice, Bob, and a disposable synthetic account before the unauthenticated list request. At the pinned revision, the list returns every database user, including those newly created accounts and their email addresses. The documentation does not establish that these evaluation-created records are within the intended public-data scope, nor does it classify their exposure as a vulnerability. This case is therefore inconclusive rather than a not_vulnerable negative control.",
      "vulnerability_class": "Public user-list access; intended data scope is unclear"
    },
    {
      "baseline_status_code": 200,
      "case_id": "user-profile-policy-unclear",
      "expected_result": "inconclusive",
      "observed_classes": [
        "API1",
        "API3",
        "internal:missing-authorization"
      ],
      "reason": "The README public-access statement is specifically about dummy users; this case queried a newly registered synthetic account. The OpenAPI describes the profile fields but does not state whether this account should be publicly readable, so the source does not support a not_vulnerable label for this exact case.",
      "vulnerability_class": "Access policy unspecified for a benign literal lookup of a registered synthetic user"
    }
  ],
